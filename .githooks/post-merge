#!/bin/bash

# Git pull 후 자동으로 빌드 및 재시작하는 hook

echo "🔄 Git pull 완료, 자동 재시작 시작... "

# 항상 프로젝트 루트에서 실행
ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "$ROOT_DIR" ]; then
  cd "$ROOT_DIR" || exit 1
fi


# PM2가 설치되어 있는지 확인
if ! command -v pm2 &> /dev/null; then
    echo "⚠️  PM2가 설치되어 있지 않습니다. 스킵합니다."
    exit 0
fi

# 모니터링 대상(변경된 파일 경로) 목록
# 여기에는 "경로"만 넣으면 됨. PM2 앱명은 파일명(확장자 제외)로 자동 생성됨.
# 예: my-bot.js -> pm2 app name: my-bot
MONITOR_FILES=(
  "my-bot.js"
  "coin-portal-bot/coin-portal-bot.js"
  "coin-portal-bot/ping.js"
  "ping.js"
)

NEED_PM2_SAVE=0

# 변경된 파일 확인
CHANGED_FILES=$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null || echo "")

changed() {
  local pattern="$1"
  echo "$CHANGED_FILES" | grep -qE "$pattern"
}

# 변경된 파일(경로)을 정확히 매칭 (정규식 이스케이프 필요 없음)
changed_file() {
  local file_path="$1"
  echo "$CHANGED_FILES" | grep -qxF "$file_path"
}

# pm2 앱을 "delete -> start"로 재생성 (프로세스가 없어도 delete는 무시)
# - app_name: pm2 프로세스명 (--name)
# - start_cmd: pm2 start에 넘길 커맨드 (예: "npm -- start")
pm2_recreate() {
  local app_name="$1"
  local start_cmd="$2"
  echo "🗑️  기존 ${app_name} 프로세스 삭제 중..."
  pm2 delete "$app_name" 2>/dev/null || true

  echo "🚀 ${app_name} 시작 중..."
  if [ -z "$start_cmd" ]; then
    echo "❌ start_cmd가 비어있습니다: $app_name"
    return 1
  fi

  # start_cmd는 여러 토큰일 수 있어 eval로 실행 (MONITOR_RULES에서만 입력)
  eval "pm2 start $start_cmd --name \"$app_name\""
}

# 파일 경로만 주면 pm2 앱명을 파일명으로 자동 생성해서 재시작
# 예: "my-bot.js" -> app "my-bot"
pm2_recreate_by_file() {
  local file_path="$1"
  local base
  local app_name

  base="$(basename "$file_path")"
  app_name="${base%.*}"

  if [ -z "$app_name" ]; then
    echo "❌ 앱 이름 추출 실패: $file_path"
    return 1
  fi

  echo "🗑️  기존 ${app_name} 프로세스 삭제 중..."
  pm2 delete "$app_name" 2>/dev/null || true

  echo "🚀 ${app_name} 시작 중... (file=${file_path})"
  # 작업 디렉토리를 명시적으로 설정하여 상대 경로 파일들을 찾을 수 있도록 함
  pm2 start "$file_path" --name "$app_name" --cwd "$ROOT_DIR"
}
# package.json이나 package-lock.json이 변경되었는지 확인
if echo "$CHANGED_FILES" | grep -qE "(package\.json|package-lock\.json)"; then
    echo "📦 의존성 파일 변경됨, 설치 중..."
    npm install
else
    echo "ℹ️  의존성 파일 변경 없음, 설치 스킵"
fi

# node_modules가 없거나 next가 없으면 설치 (안전장치)
# next는 dependencies에 있으므로 --production으로도 설치되어야 하지만,
# 혹시 모를 상황을 대비한 체크
if [ ! -d "node_modules" ] || [ ! -f "node_modules/.bin/next" ]; then
    echo "⚠️  node_modules가 없거나 next가 없음, 설치 중..."
    npm install
fi

# 빌드가 필요한 파일이 변경되었는지 확인
# app/, trade-server/ 디렉토리, next.config.js, instrumentation.js, package.json 변경 시에만 빌드 필요
# 정적 파일은 빌드 불필요
if changed "(^app/|^trade-server/|^next\.config\.js$|^instrumentation\.js$|^package\.json$)"; then
    echo "🔨 빌드 필요한 파일 변경됨, 빌드 중..."
    npm run build
else
    echo "ℹ️  빌드 필요한 파일 변경 없음, 빌드 스킵 (정적 파일만 변경된 경우 재시작만)"
fi

# Next.js 서버는 항상 재시작 (git pull 이후 코드 반영 목적)
# 주의: pm2의 --name 옵션은 "--" 구분자보다 앞에 와야 함 (npm start의 "--" 때문에 순서 중요)
echo "🔄 Next.js 서버 시작 중..."
pm2 delete nextjs-server 2>/dev/null || true
pm2 delete letsmeet-dashboard 2>/dev/null || true

cd "$ROOT_DIR" || exit 1
pm2 start npm --name nextjs-server --cwd "$ROOT_DIR" -- start
NEED_PM2_SAVE=1

# 나머지 봇들은 변경된 경우에만 재시작
for file_path in "${MONITOR_FILES[@]}"; do
  if changed_file "$file_path"; then
    echo "🔁 변경 감지: ${file_path}"
    pm2_recreate_by_file "$file_path" && NEED_PM2_SAVE=1
  else
    echo "ℹ️  변경 없음: ${file_path}"
  fi
done

if [ "$NEED_PM2_SAVE" -eq 1 ]; then
  pm2 save
fi

echo "✅ 자동 재시작 완료!"

